[
    {
        "step_title": "媒体与网络",
        "items": [
            {
                "desc": "请输入存放视频的共享文件夹完整路径，例如 /volume1/video。安装完成后，请到“控制面板 > 共享文件夹 > 权限 > 系统内部用户”，将该文件夹的读取权限授予套件用户 PeachZhTW。"
            },
            {
                "type": "textfield",
                "desc": "媒体文件夹",
                "subitems": [
                    {
                        "key": "wizard_media_path",
                        "desc": "媒体文件夹路径",
                        "defaultValue": "/volume1/video",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^\\/[^\\x00-\\x1f]+$/",
                                "errorText": "请输入以 / 开头的完整路径。"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "网页端口",
                "subitems": [
                    {
                        "key": "wizard_port",
                        "desc": "端口（1024-65535）",
                        "defaultValue": "8900",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^(102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$/",
                                "errorText": "请输入 1024 到 65535 之间的端口。"
                            }
                        }
                    }
                ]
            }
        ]
    },
    {
        "step_title": "访问密码与 FFmpeg",
        "items": [
            {
                "desc": "访问密码用来保护局域网中的 Peach 网页（8 到 256 个字符）。"
            },
            {
                "type": "password",
                "desc": "访问密码",
                "subitems": [
                    {
                        "key": "wizard_access_password",
                        "desc": "密码",
                        "validator": {
                            "allowBlank": false,
                            "minLength": 8,
                            "maxLength": 256
                        }
                    }
                ]
            },
            {
                "desc": "建议安装 SynoCommunity 的 FFmpeg 套件后把这一栏留空，Peach 启动时会自动找到它。要使用其他 FFmpeg 时，才填入包含 ffmpeg 与 ffprobe 程序的文件夹完整路径。没有 FFmpeg 时，MP4 等浏览器可直接播放的格式仍能播放，但缩略图与转码无法使用。"
            },
            {
                "type": "textfield",
                "desc": "FFmpeg 文件夹",
                "subitems": [
                    {
                        "key": "wizard_ffmpeg_dir",
                        "desc": "FFmpeg 文件夹路径（选填）",
                        "defaultValue": "",
                        "validator": {
                            "allowBlank": true,
                            "regex": {
                                "expr": "/^\\/[^\\x00-\\x1f]*$/",
                                "errorText": "请输入以 / 开头的完整路径。"
                            }
                        }
                    }
                ]
            }
        ]
    }
]
