[
    {
        "step_title": "媒體與網路",
        "items": [
            {
                "desc": "請輸入存放影片的共用資料夾完整路徑，例如 /volume1/video。安裝完成後，請到「控制台 > 共用資料夾 > 權限 > 系統內部使用者」，將該資料夾的讀取權限授予套件使用者 PeachZhTW。"
            },
            {
                "type": "textfield",
                "desc": "媒體資料夾",
                "subitems": [
                    {
                        "key": "wizard_media_path",
                        "desc": "媒體資料夾路徑",
                        "defaultValue": "/volume1/video",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^\\/[^\\x00-\\x1f]+$/",
                                "errorText": "請輸入以 / 開頭的完整路徑。"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "網頁連接埠",
                "subitems": [
                    {
                        "key": "wizard_port",
                        "desc": "連接埠（1024-65535）",
                        "defaultValue": "8900",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^(102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$/",
                                "errorText": "請輸入 1024 到 65535 之間的連接埠。"
                            }
                        }
                    }
                ]
            }
        ]
    },
    {
        "step_title": "存取密碼與 FFmpeg",
        "items": [
            {
                "desc": "存取密碼用來保護區域網路中的 Peach 網頁（8 到 256 個字元）。"
            },
            {
                "type": "password",
                "desc": "存取密碼",
                "subitems": [
                    {
                        "key": "wizard_access_password",
                        "desc": "密碼",
                        "validator": {
                            "allowBlank": false,
                            "minLength": 8,
                            "maxLength": 256
                        }
                    }
                ]
            },
            {
                "desc": "選填：包含 ffmpeg 與 ffprobe 程式的資料夾完整路徑。沒有的話可留空；MP4 等瀏覽器可直接播放的格式仍能播放，但縮圖與轉碼需要 FFmpeg。"
            },
            {
                "type": "textfield",
                "desc": "FFmpeg 資料夾",
                "subitems": [
                    {
                        "key": "wizard_ffmpeg_dir",
                        "desc": "FFmpeg 資料夾路徑（選填）",
                        "defaultValue": "",
                        "validator": {
                            "allowBlank": true,
                            "regex": {
                                "expr": "/^\\/[^\\x00-\\x1f]*$/",
                                "errorText": "請輸入以 / 開頭的完整路徑。"
                            }
                        }
                    }
                ]
            }
        ]
    }
]
