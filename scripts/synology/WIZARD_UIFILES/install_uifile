[
    {
        "step_title": "Media and network",
        "items": [
            {
                "desc": "Enter the full path of the shared folder that holds your videos, for example /volume1/video. After installation, grant the package user PeachZhTW read permission on that folder in Control Panel > Shared Folder > Permissions > System internal user."
            },
            {
                "type": "textfield",
                "desc": "Media folder",
                "subitems": [
                    {
                        "key": "wizard_media_path",
                        "desc": "Media folder path",
                        "defaultValue": "/volume1/video",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^\\/[^\\x00-\\x1f]+$/",
                                "errorText": "Enter an absolute path that starts with /."
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "Web port",
                "subitems": [
                    {
                        "key": "wizard_port",
                        "desc": "Port (1024-65535)",
                        "defaultValue": "8900",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^(102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$/",
                                "errorText": "Enter a port from 1024 to 65535."
                            }
                        }
                    }
                ]
            }
        ]
    },
    {
        "step_title": "Access password and FFmpeg",
        "items": [
            {
                "desc": "The access password protects the Peach web page on your network (8 to 256 characters)."
            },
            {
                "type": "password",
                "desc": "Access password",
                "subitems": [
                    {
                        "key": "wizard_access_password",
                        "desc": "Password",
                        "validator": {
                            "allowBlank": false,
                            "minLength": 8,
                            "maxLength": 256
                        }
                    }
                ]
            },
            {
                "desc": "Recommended: install the SynoCommunity FFmpeg package and leave this empty; Peach finds it at startup. To use another FFmpeg, enter the absolute path of a folder that contains the ffmpeg and ffprobe programs. Without FFmpeg, browsable formats such as MP4 still play, but thumbnails and transcoding are unavailable."
            },
            {
                "type": "textfield",
                "desc": "FFmpeg folder",
                "subitems": [
                    {
                        "key": "wizard_ffmpeg_dir",
                        "desc": "FFmpeg folder path (optional)",
                        "defaultValue": "",
                        "validator": {
                            "allowBlank": true,
                            "regex": {
                                "expr": "/^\\/[^\\x00-\\x1f]*$/",
                                "errorText": "Enter an absolute path that starts with /."
                            }
                        }
                    }
                ]
            }
        ]
    }
]
